# ==============================================================================
# Retail Data Warehouse & Automated BI Reporting Platform - Environment Config
# NOTE: This is a safe configuration template. Never commit actual credentials.
# ==============================================================================

# Azure Subscription & Resource Group
AZURE_SUBSCRIPTION_ID="00000000-0000-0000-0000-000000000000"
AZURE_RESOURCE_GROUP="rg-retail-reporting-dev"
AZURE_REGION="eastus"

# Azure Blob Storage / Data Lake Gen2
AZURE_STORAGE_ACCOUNT_NAME="stretaildatadev"
AZURE_STORAGE_CONTAINER_RAW="raw-transactions"
AZURE_STORAGE_CONTAINER_CURATED="curated-transactions"
AZURE_STORAGE_ACCESS_KEY="<YOUR_STORAGE_ACCOUNT_KEY_OR_USE_MANAGED_IDENTITY>"

# Azure Databricks
DATABRICKS_HOST="https://adb-0000000000000000.0.azuredatabricks.net"
DATABRICKS_CLUSTER_ID="0000-000000-xxxxxx"
DATABRICKS_TOKEN="<YOUR_DATABRICKS_PERSONAL_ACCESS_TOKEN>"

# Azure SQL Database
AZURE_SQL_SERVER_NAME="sql-retail-reporting-dev.database.windows.net"
AZURE_SQL_DATABASE_NAME="sqldb-retail-dw"
AZURE_SQL_ADMIN_USER="sqladminuser"
AZURE_SQL_ADMIN_PASSWORD="<YOUR_STRONG_SQL_PASSWORD>"

# Azure Data Factory
ADF_FACTORY_NAME="adf-retail-reporting-pipeline"
ADF_PIPELINE_NAME="pl_daily_retail_sales_ingestion"
