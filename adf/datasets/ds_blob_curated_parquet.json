{
    "name": "ds_blob_curated_parquet",
    "type": "Microsoft.DataFactory/factories/datasets",
    "properties": {
        "description": "Cleaned, validated, and transformed Parquet transaction dataset generated by Databricks",
        "linkedServiceName": {
            "referenceName": "ls_azure_blob_storage",
            "type": "LinkedServiceReference"
        },
        "parameters": {
            "ContainerName": {
                "type": "string",
                "defaultValue": "curated-transactions"
            },
            "DirectoryPath": {
                "type": "string",
                "defaultValue": "date=20261001"
            }
        },
        "annotations": [],
        "type": "Parquet",
        "typeProperties": {
            "location": {
                "type": "AzureBlobStorageLocation",
                "folderPath": "@dataset().DirectoryPath",
                "container": "@dataset().ContainerName"
            },
            "compressionCodec": "snappy"
        },
        "schema": []
    }
}
