{
    "name": "ds_blob_raw_csv",
    "type": "Microsoft.DataFactory/factories/datasets",
    "properties": {
        "description": "Daily raw sales transaction CSV files in Azure Blob Storage",
        "linkedServiceName": {
            "referenceName": "ls_azure_blob_storage",
            "type": "LinkedServiceReference"
        },
        "parameters": {
            "ContainerName": {
                "type": "string",
                "defaultValue": "raw-transactions"
            },
            "FileName": {
                "type": "string",
                "defaultValue": "daily_transactions_20261001.csv"
            }
        },
        "annotations": [],
        "type": "DelimitedText",
        "typeProperties": {
            "location": {
                "type": "AzureBlobStorageLocation",
                "fileName": "@dataset().FileName",
                "container": "@dataset().ContainerName"
            },
            "columnDelimiter": ",",
            "escapeChar": "\\",
            "firstRowAsHeader": true,
            "quoteChar": "\""
        },
        "schema": []
    }
}
